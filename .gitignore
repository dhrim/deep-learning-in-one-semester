__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
*.egg-info/
.DS_Store

# 그림: SVG만 올린다. PNG는 make_figures.py로 다시 만든다
figures/*.png
!figures/.gitkeep

# 데이터셋·사전학습 가중치는 올리지 않는다 (424MB, GitHub 파일 한도 초과)
# 받는 방법은 data/README.md 에 적혀 있다
data/*
!data/README.md

# 노트북이 실행 중에 만드는 산출물 (모델 저장 실습 등).
# 노트북을 돌리면 다시 생긴다.
notebooks/**/*.keras
notebooks/**/*.pt
notebooks/**/*.pth
notebooks/**/*.h5
notebooks/**/*.png
notebooks/**/*.csv
